{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "src/ingest/chunker.ts"
  ],
  "reporters": [
    "clear-text",
    "html"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [
    "reports",
    ".stryker-tmp"
  ]
}