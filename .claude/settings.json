{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-paths.sh"
					}
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(npm run check)",
			"Bash(npm run test *)",
			"Bash(npm run typecheck)",
			"Bash(npm run lint)",
			"Bash(npx vitest *)",
			"Bash(git status *)",
			"Bash(git diff *)",
			"Bash(git log *)"
		],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(rm -rf *)"
		]
	},
	"worktree": {
		"baseRef": "head"
	}
}