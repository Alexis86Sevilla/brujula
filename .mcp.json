{
  "mcpServers": {
    "ado": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@azure-devops/mcp@2.11.0",
        "${ADO_ORG}",
        "--authentication",
        "azcli",
        "-d",
        "core",
        "work",
        "work-items",
        "repositories",
        "wiki"
      ]
    },
    "brujula": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "tsx",
        "src/mcp/main.ts"
      ],
      "env": {
        "BRUJULA_ROOT": "${CLAUDE_PROJECT_DIR:-.}"
      }
    }
  }
}